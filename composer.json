{
    "name": "ugurcan/virtuagym-wallet-sample",
    "description": "Wallet provisioning with a queued job, synchronous fallback and a deposit consumer.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "cache-dir": "storage/composer-cache"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
