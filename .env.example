APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_KEY=
DB_CONNECTION=sqlite
# SQLite defaults to database/wallet-demo.sqlite and needs no password.
# An optional MySQL deployment would inject DB_HOST, DB_PORT, DB_DATABASE,
# DB_USERNAME and DB_PASSWORD. MySQL has not been tested here.

# Optional local RabbitMQ demo. Never commit actual credentials.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
